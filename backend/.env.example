# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# --- Server ---
PORT=5000

CLIENT_URL=http://localhost:3000

# --- Auth ---
# สุ่มค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lmsit

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# ลำดับ model ที่จะลอง (ตัวแรกไม่ว่าง → สลับไปตัวถัดไปอัตโนมัติ)
GEMINI_MODELS=gemini-2.5-flash,gemini-3.8-flash,gemini-2.5-flash-lite
