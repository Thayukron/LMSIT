# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# --- Server ---
PORT=5000

CLIENT_URL=http://localhost:3000

# --- Auth ---
# สุ่มค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lmsit

# --- AI (Google Gemini) ---
# key ส่วนกลาง (ไม่บังคับ) — ใช้เมื่อ ALLOW_SHARED_AI_KEY=true
GEMINI_API_KEY=
# ลำดับ model ที่จะลอง (ตัวแรกไม่ว่าง → สลับไปตัวถัดไปอัตโนมัติ)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# เก็บเนื้อหาแต่ละสไตล์ไว้กี่เวอร์ชัน (1-3) — 1 ประหยัดโควตา key ฟรี, 2-3 เนื้อหาหลากหลายขึ้น
AI_CACHE_VERSIONS=1

# --- AI key ของครูรายวิชา ---
# ครูใส่ Gemini API key ของตัวเองในหน้าจัดการวิชา (เก็บแบบเข้ารหัสด้วย AI_KEY_SECRET)
# ⚠️ ถ้าเปลี่ยน AI_KEY_SECRET ภายหลัง key ที่บันทึกไว้จะใช้ไม่ได้ ครูต้องใส่ใหม่
AI_KEY_SECRET=
# true = วิชาที่ยังไม่มี key ใช้ GEMINI_API_KEY ด้านบนแทน | false = ทุกวิชาต้องมี key ของตัวเอง
ALLOW_SHARED_AI_KEY=false
